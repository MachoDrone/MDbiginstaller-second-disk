#!/usr/bin/env bash
# Generated by tools/build.py. Edit files in src/.
# Derived from MachoDrone/MDbiginstaller; second-disk experimental fork.
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() { printf 'STOP: %s\n' "$*" >&2; exit 1; }
usage() {
    cat <<'HELP'
Nosana installer with optional second-disk storage (fresh installations only)
Usage: bash installer-beta.sh [--storage-only | --list-disks | --verify-storage | --recover-storage]
       bash installer-beta.sh [--prepare-nosana | --verify-nosana | --start-nosana]
  No option: choose storage, install Docker/NVIDIA support, prepare Nosana on a second disk.
  --storage-only: prepare storage without installing Docker or GPU software.
  --list-disks: inspect eligible disks without changing disk contents/configuration.
  --verify-storage: verify an already completed storage setup.
  --recover-storage: remove this wizard's interrupted configuration; retain filesystem data.
  --prepare-nosana: finish or resume Nosana preparation on managed second-disk storage.
  --verify-nosana: check prepared Nosana files and cached images without starting a node.
  --start-nosana: explicitly start the prepared Nosana host after any needed driver reboot.
Supported: native x86-64 Ubuntu 22.04/24.04, rootful Docker, fresh runtime installation.
HELP
}
mode=${1:-install}
[[ $# -le 1 ]] || { usage; exit 1; }
case "$mode" in
    --help|-h) usage; exit 0 ;;
    install|--storage-only|--list-disks|--verify-storage|--recover-storage|--prepare-nosana|--verify-nosana|--start-nosana) ;;
    *) usage; exit 1 ;;
esac
[[ $EUID -ne 0 ]] || fail 'Run as your normal Ubuntu user; do not put sudo before bash.'
[[ -t 0 && -t 1 ]] || fail 'Download this file, then run it from an interactive terminal.'
[[ -r /etc/os-release ]] || fail 'Cannot identify this operating system.'
# shellcheck disable=SC1091
source /etc/os-release
[[ ${ID:-} == ubuntu && ${VERSION_ID:-} =~ ^(22\.04|24\.04)$ ]] || fail 'This fork currently supports native Ubuntu 22.04 and 24.04 only.'
[[ $(dpkg --print-architecture) == amd64 ]] || fail 'This release is tested with x86-64 Ubuntu only.'
if grep -qiE 'microsoft|wsl' /proc/version /proc/sys/kernel/osrelease; then
    fail 'WSL is unsupported.'
fi
[[ -d /run/systemd/system ]] || fail 'A native systemd installation is required.'
command -v python3 >/dev/null || fail 'Python 3 is required (included in standard Ubuntu).'
sudo -v
work=$(mktemp -d)
trap 'rm -rf -- "$work"' EXIT
trap 'printf "\nInstallation stopped on line %s. Read the error above; no automatic reboot will occur.\n" "$LINENO" >&2' ERR
cat > "$work/storage.py" <<'NOSANA_STORAGE_PY'
@@STORAGE_PY@@
NOSANA_STORAGE_PY
cat > "$work/adoption.py" <<'NOSANA_ADOPTION_PY'
@@ADOPTION_PY@@
NOSANA_ADOPTION_PY
cat > "$work/nosana.py" <<'NOSANA_HOST_PY'
@@NOSANA_PY@@
NOSANA_HOST_PY
storage() { sudo /usr/bin/python3 -B "$work/storage.py" "$@"; }
nosana() { sudo /usr/bin/python3 -B "$work/nosana.py" "$@"; }
case "$mode" in
    --storage-only) storage; exit ;;
    --list-disks) storage --list; exit ;;
    --verify-storage) storage --verify; exit ;;
    --recover-storage) storage --recover; exit ;;
    --prepare-nosana) storage --verify; nosana prepare; exit ;;
    --verify-nosana) storage --verify; nosana verify; exit ;;
    --start-nosana) storage --verify; nosana start; exit ;;
esac

printf '\nNosana installer — fresh installations only\n'
printf '1) Docker prerequisites on the OS disk (default)\n2) Docker and Nosana on a second disk, including an existing /var/lib/docker mount\n'
read -r -p 'Storage choice [1/2, Enter = 1]: ' storage_choice
case "${storage_choice:-1}" in
    1) storage --check-fresh; second_disk=no ;;
    2) storage; second_disk=yes ;;
    *) fail 'Invalid choice; nothing was installed.' ;;
esac
if command -v dockerd >/dev/null || command -v containerd >/dev/null; then
    [[ $second_disk == yes ]] || fail 'An existing runtime was found. This installer does not migrate or replace an existing host.'
    storage --verify
    printf 'Managed Docker/containerd verified. Skipping Docker package installation; continuing unfinished setup.\n'
else
printf '\nStorage selection is complete. Next: install Docker packages.\n'
read -r -p 'Continue with package installation? [y/N]: ' answer
[[ $answer =~ ^[yY]$ ]] || { printf 'Stopped before package installation. You can rerun this file later.\n'; exit 0; }

sudo apt-get update
sudo apt-get install -y ca-certificates curl gnupg
sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o "$work/docker.asc"
sudo install -m 0644 "$work/docker.asc" /etc/apt/keyrings/docker.asc
printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu %s stable\n' \
    "$(dpkg --print-architecture)" "$VERSION_CODENAME" > "$work/docker.list"
if sudo test -e /etc/apt/sources.list.d/nosana-docker.list; then
    sudo cmp -s "$work/docker.list" /etc/apt/sources.list.d/nosana-docker.list || fail 'A different Docker package source already exists.'
else
    sudo install -m 0644 "$work/docker.list" /etc/apt/sources.list.d/nosana-docker.list
fi
sudo apt-get update
# Keep the storage configuration written BEFORE apt starts services automatically.
sudo apt-get -o Dpkg::Options::=--force-confold install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
sudo usermod -aG docker "$(id -un)"
sudo systemctl enable --now containerd docker
if [[ $second_disk == yes ]]; then
    storage --verify
fi
sudo docker info --format 'Docker {{.ServerVersion}} — storage {{.DockerRootDir}}'
fi

printf '\nDocker is installed. Existing GPU drivers have not been changed.\n'
if command -v nvidia-smi >/dev/null && nvidia-smi >/dev/null 2>&1; then
    printf 'A working NVIDIA driver was detected; keeping it.\n'
else
    printf 'No working NVIDIA driver was detected. Installing a driver can require a reboot.\n'
    read -r -p 'Install or replace the NVIDIA driver with the recommended Ubuntu version? [y/N]: ' answer
    if [[ $answer =~ ^[yY]$ ]]; then
        sudo apt-get install -y ubuntu-drivers-common mokutil
        if mokutil --sb-state 2>/dev/null | grep -qi enabled; then
            fail 'Secure Boot is enabled. Driver installation needs a separate Secure Boot plan; storage and Docker are already configured.'
        fi
        sudo ubuntu-drivers install
    fi
fi
if command -v nvidia-ctk >/dev/null && sudo docker info --format '{{json .Runtimes}}' | python3 -c 'import json,sys; sys.exit("nvidia" not in json.load(sys.stdin))'; then
    printf 'NVIDIA Container Toolkit is already configured; keeping it.\n'
else
read -r -p 'Install NVIDIA Container Toolkit for GPU containers? [y/N]: ' answer
if [[ $answer =~ ^[yY]$ ]]; then
    curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey -o "$work/nvidia.asc"
    gpg --batch --yes --dearmor -o "$work/nvidia.gpg" "$work/nvidia.asc"
    sudo install -m 0644 "$work/nvidia.gpg" /etc/apt/keyrings/nosana-nvidia.gpg
    curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list -o "$work/nvidia.list"
    sed 's#deb https://#deb [signed-by=/etc/apt/keyrings/nosana-nvidia.gpg] https://#g' "$work/nvidia.list" > "$work/nvidia-signed.list"
    sudo install -m 0644 "$work/nvidia-signed.list" /etc/apt/sources.list.d/nosana-nvidia.list
    sudo apt-get update
    sudo apt-get install -y nvidia-container-toolkit
    sudo nvidia-ctk runtime configure --runtime=docker
    sudo systemctl restart docker
    [[ $second_disk != yes ]] || storage --verify
fi
fi
if [[ $second_disk == yes ]]; then
    storage --verify
    nosana prepare
fi
printf '\nSelected installation steps completed. No automatic reboot is performed.\n'
printf 'Log out and back in for Docker group access. Reboot when convenient if you installed a driver.\n'
if [[ $second_disk == yes ]]; then
    printf 'Nosana is prepared on the second disk. After any needed reboot, start it with:\n'
    printf '  bash installer-beta.sh --start-nosana\n'
else
    printf 'OS-disk mode installed Docker prerequisites. Nosana setup requires the managed second-disk option.\n'
fi
